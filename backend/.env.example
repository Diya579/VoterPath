# Copy this file to .env and fill in your Firebase credentials
# Get serviceAccountKey.json from Firebase Console > Project Settings > Service Accounts

FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional: Event start time (ISO format) for time-based predictions
EVENT_START_TIME=2026-04-24T20:00:00+05:30
