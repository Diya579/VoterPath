# VoterPath — Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─── Firebase (Frontend) ───────────────────────────────────────
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Backend ───────────────────────────────────────────────────
# Groq LLM API key — https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key

# Firebase Admin SDK — JSON stringified service account
# Obtain from: Firebase Console → Project Settings → Service Accounts
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
ALLOWED_ORIGINS=https://voterpath-776684989084.us-central1.run.app,http://localhost:5173
